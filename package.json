{
  "name": "@mcb/design-system",
  "version": "0.1.0",
  "description": "Design system de MC Blueprint: tokens y primitivas de UI para editores densos y oscuros",
  "license": "MIT",
  "author": "MC Blueprint",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luccar31/mcb-design-system.git"
  },
  "homepage": "https://github.com/luccar31/mcb-design-system#readme",
  "bugs": "https://github.com/luccar31/mcb-design-system/issues",
  "keywords": [
    "design-system",
    "react",
    "components",
    "design-tokens",
    "dark-ui",
    "minecraft"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/mcb-design-system.css",
    "./tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "build": "tsc -p tsconfig.build.json --noEmit && vite build",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build-storybook": "storybook build -o storybook-static",
    "shots": "node scripts/shots.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "8.6.18",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "playwright": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "8.6.18",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vite-plugin-dts": "^4.3.0"
  }
}
